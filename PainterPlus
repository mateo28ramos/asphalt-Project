import org.code.neighborhood.*;

public class PainterPlus extends Painter{

  public void turnRight(){
  turnLeft();
  turnLeft();
  turnLeft();
  }

  public void takeAllPaint(){
  while(isOnBucket()){
    takePaint();
   }
 }
  
    public void moveFast(){
      while(canMove()){
        move();
      }
   }

public void paintToEmpty(String color){
  while(hasPaint()){
    paint(color);
    move();
  }
}

public void paintDonut(String color){
  while(hasPaint()){
    move();
    turnRight();
    paint(color);
    move();
    paint(color);
  }
}

  public void paintGrass(){
    while(canMove()){
    paint("SpringGreen");
    move();
    paint("SpringGreen");
    }
  }

  public void paintSky(){
    while(canMove()){
    paint("cyan"); 
    move();
    paint("cyan");
    }
  }

  public void RmR(){
    turnRight();
    move();
    turnRight();
  }
  
    public void LmL(){
    turnLeft();
    move();
    turnLeft();
    }
      
  public void SKY(){
    paintSky();
    RmR();
    paintSky();
    LmL();
    paintSky();
    RmR();
    paintSky();
    LmL();
    paintSky();
    RmR();
    paintSky();
    LmL();
    paintSky();
    RmR();
    paintSky();
    LmL();
    paintSky();
    RmR();
    paintSky();
    LmL();
    
  }

  public void Pmove(){
    move();
    paint("white");
  }
}
